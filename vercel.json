{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/novidades",
      "destination": "/novidades.html"
    },
    {
      "source": "/status",
      "destination": "/status.html"
    },
    {
      "source": "/estado",
      "destination": "/estado.html"
    },
    {
      "source": "/guias",
      "destination": "/guias.html"
    },
    {
      "source": "/grade",
      "destination": "/index.html"
    },
    {
      "source": "/beta",
      "destination": "/index.html"
    },
    {
      "source": "/hoje",
      "destination": "/index.html"
    },
    {
      "source": "/desafios",
      "destination": "/index.html"
    },
    {
      "source": "/calendario",
      "destination": "/index.html"
    },
    {
      "source": "/incursoes",
      "destination": "/index.html"
    },
    {
      "source": "/masmorras",
      "destination": "/index.html"
    },
    {
      "source": "/campanhas",
      "destination": "/index.html"
    },
    {
      "source": "/missoes-exoticas",
      "destination": "/index.html"
    },
    {
      "source": "/titulos",
      "destination": "/index.html"
    },
    {
      "source": "/triunfos",
      "destination": "/index.html"
    },
    {
      "source": "/colecionaveis",
      "destination": "/index.html"
    },
    {
      "source": "/personagens",
      "destination": "/index.html"
    },
    {
      "source": "/cofre",
      "destination": "/index.html"
    },
    {
      "source": "/exoticos",
      "destination": "/index.html"
    },
    {
      "source": "/catalisadores",
      "destination": "/index.html"
    },
    {
      "source": "/vendedores",
      "destination": "/index.html"
    },
    {
      "source": "/padroes",
      "destination": "/index.html"
    },
    {
      "source": "/itens-novos",
      "destination": "/index.html"
    },
    {
      "source": "/loadouts",
      "destination": "/index.html"
    },
    {
      "source": "/builds",
      "destination": "/index.html"
    },
    {
      "source": "/armaduras",
      "destination": "/index.html"
    },
    {
      "source": "/relatorios",
      "destination": "/index.html"
    },
    {
      "source": "/estatisticas",
      "destination": "/index.html"
    },
    {
      "source": "/membros",
      "destination": "/index.html"
    },
    {
      "source": "/placar",
      "destination": "/index.html"
    },
    {
      "source": "/grupos",
      "destination": "/index.html"
    },
    {
      "source": "/administracao",
      "destination": "/index.html"
    },
    {
      "source": "/discord",
      "destination": "/index.html"
    },
    {
      "source": "/beta/:aba",
      "destination": "/index.html"
    },
    {
      "source": "/b/:c",
      "destination": "https://dni-api.dni-site.workers.dev/page/:c"
    },
    {
      "source": "/bi/:c",
      "destination": "https://dni-api.dni-site.workers.dev/pubimg/:c"
    },
    {
      "source": "/g/:s",
      "destination": "https://dni-api.dni-site.workers.dev/gpage/:s"
    }
  ],
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else echo \"branch $VERCEL_GIT_COMMIT_REF: sem publicacao (so a main publica)\"; exit 0; fi",
  "redirects": [
    {
      "source": "/videos",
      "destination": "/guias?t=vid",
      "permanent": false
    }
  ]
}
