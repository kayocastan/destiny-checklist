{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/novidades",
      "destination": "/novidades.html"
    },
    {
      "source": "/status",
      "destination": "/status.html"
    },
    {
      "source": "/estado",
      "destination": "/estado.html"
    },
    {
      "source": "/grade",
      "destination": "/index.html"
    },
    {
      "source": "/beta",
      "destination": "/index.html"
    },
    {
      "source": "/b/:c",
      "destination": "https://dni-api.dni-site.workers.dev/page/:c"
    },
    {
      "source": "/bi/:c",
      "destination": "https://dni-api.dni-site.workers.dev/pubimg/:c"
    },
    {
      "source": "/g/:s",
      "destination": "https://dni-api.dni-site.workers.dev/gpage/:s"
    }
  ],
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else echo \"branch $VERCEL_GIT_COMMIT_REF: sem publicacao (so a main publica)\"; exit 0; fi"
}
